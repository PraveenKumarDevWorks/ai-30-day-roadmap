generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DocumentChunk {
  id         Int      @id @default(autoincrement())
  source     String
  chunkIndex Int      @map("chunk_index")
  content    String
  embedding  Unsupported("vector(768)")?
  createdAt  DateTime @default(now())

  @@map("document_chunks")
}
